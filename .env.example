# --- Supabase Postgres (recommended for Vercel) ---
# In Supabase: Project Settings → Database → Connection string.
# For serverless (Vercel), use the "Transaction pooler" URI (port 6543), not the direct DB URL.
# Replace [YOUR-PASSWORD] with your database password from the same page.
# Example shape (region/host vary by project):
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"

# For local `prisma migrate deploy`, you can use the same pooled URL, or the "Direct connection"
# URI (port 5432) from Supabase if migrations fail through the pooler.

# --- Auth (set in Vercel → Settings → Environment Variables; do not commit .env) ---
# Generate with: npx auth secret   OR   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Optional locally; Vercel sets automatically. Example:
# NEXTAUTH_URL="http://localhost:3000"

# Optional: profile photo uploads (Vercel → Storage → Blob → create token)
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
