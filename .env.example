# PostgreSQL (e.g. Neon, Supabase, or Vercel Postgres). Required at runtime and for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Generate with: npx auth secret   OR   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Optional locally; Vercel sets automatically. Example:
# NEXTAUTH_URL="http://localhost:3000"

# Optional: profile photo uploads (Vercel Dashboard → Storage → Blob → create token)
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
